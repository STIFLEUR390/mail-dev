{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "sentry:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://spamcheck.postmarkapp.com/*" }]
    },
    "dialog:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    "fs:default",
    "notification:default",
    "updater:default",
    "process:default",
    "sql:default",
    "sql:allow-execute"
  ]
}
