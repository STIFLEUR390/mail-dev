{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mail-dev",
  "version": "0.9.0",
  "identifier": "com.stifleur390.mail-dev",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mail Dev",
        "width": 1100,
        "height": 700,
        "minWidth": 950,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: blob: data: filesystem: ws: wss: http: https: 'unsafe-eval' 'unsafe-inline'; img-src 'self' data: blob: http: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:maildev.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MkVFQTg2RDVFREUwMjYKUldRbTRPM1ZodW91WnB3M0pHcloyUFFjc3RVZ1I1WXV1T3Y0OU9Yc05YMkFxSVpkOTJkc3grOWEK",
      "endpoints": [
        "https://github.com/STIFLEUR390/mail-dev/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "MIT © Franck Hérold TAMTO TAMKO",
    "category": "DeveloperTool",
    "shortDescription": "Local SMTP server for email testing and debugging",
    "longDescription": "Mail-Dev is a local SMTP server for email testing and debugging. It captures incoming emails, lets you inspect their HTML/text/raw content, spam score and attachments, and forwards them to a real SMTP server when needed.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
